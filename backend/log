#!/usr/bin/env python3

# This program stores the information about the running processes on an AIX
# compute node in a file.

import os, sys, subprocess
import time
import multiprocessing
import configparser

# Get the path to 'lib' and add it to Python's search path
lib_path = os.path.abspath(os.path.join(os.path.dirname(__file__), '..', 'lib'))
sys.path.insert(0, lib_path)

import appinfo
import joblist

# Ignored users/programs do not show up on reports. Allowed users
# do show up, but are not required to have a connected job.

# Global variables (do not edit)
hostName        = ""
rootDir         = ""
ignoredUsers    = []
ignoredPrograms = []
allowedUsers    = []
checkCategories = []
coresPerNode    = 0


# ******************************************************************************

def init():
  global hostName, rootDir, ignoredUsers, ignoredPrograms, allowedUsers, checkCategories, coresPerNode, softwareDirs, softwareDirPatterns

  # Get the current host name
  result = subprocess.run(
    ["hostname"],
    shell=True,
    stdout=subprocess.PIPE,
    stderr=subprocess.PIPE,
    universal_newlines=True,  # Works in 3.6 and 3.9 (decodes stdout/stderr to str)
    check=True,  # Optional: raises CalledProcessError if return code != 0
  )
  hostName = result.stdout.strip().split('.')[0]

  # Get the root directory, where this script is located
  relPath = os.path.dirname(sys.argv[0])
  absPath = os.path.abspath(relPath)

  # Remove the ending '/'
  if absPath.endswith('/'):
    absPath = absPath.rstrip('/')

  # Remove the bin directory
  if absPath.endswith('backend'):
    absPath = os.path.dirname(absPath)

  # Make certain that the path ends with a '/'
  if not absPath.endswith('/'):
    absPath += '/'

  rootDir = absPath

  # Read info from config file
  config = configparser.ConfigParser()
  config.read(rootDir+'etc/config')
  list = config.get('Log', 'ignoredUsers').strip().split(',')
  for item in list:
    ignoredUsers.append(item.strip())
  list = config.get('Log', 'ignoredPrograms').strip().split(',')
  for item in list:
    ignoredPrograms.append(item.strip())
  list = config.get('Log', 'allowedUsers').strip().split(',')
  for item in list:
    allowedUsers.append(item.strip())
  list = config.get('Log', 'checkCategories').strip().split(',')
  for item in list:
    checkCategories.append(item.strip())
  hyperThreading = config.get('Log', 'hyperThreading').strip()

  # Set the number of cores per node
  coresPerNode = multiprocessing.cpu_count()
  if hyperThreading == '1':
    coresPerNode = coresPerNode / 2

  appinfo.init(config, "Log", rootDir)

  ok = joblist.init(config)
  if ok:
    # Read the list of jobs that should be running on this node
    joblist.read(rootDir+"log/joblist", hostName)

  return  ok

# ******************************************************************************

# Get a list of information about the processes currently running on this
# compute node
def getProcessInfo(hostname):
  known   = dict()
  unknown = []

  # Get the list of running processes
  result = subprocess.run(
    ['ps -H -e -opid=,user:20=,pcpu=,comm='],
    shell=True,
    stdout=subprocess.PIPE,
    stderr=subprocess.PIPE,
    universal_newlines=True,  # Works in 3.6 and 3.9 (decodes stdout/stderr to str)
    check=True,  # Optional: raises CalledProcessError if return code != 0
  )
  psLines = result.stdout.strip()

  # Get the current time in seconds
  now = str(time.time())

  # Fill known with information about all running processes
  for line in psLines.split('\n'):
    # Get the information about a single process
    try:
      pid,user,pcpu,cmd = line.strip().split()
    except:
      continue

    # Skip OS processes
    if user in ignoredUsers:
      continue

    # Skip empty commands (should never occur)
    if len(cmd) == 0:
      continue

    # Read the symbolic link /proc/<procid>/exe
    try:
      cmd = rootDir+"backend/readexelink "+pid
      result = subprocess.run(
        [cmd],
        shell=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        universal_newlines=True,  # Works in 3.6 and 3.9 (decodes stdout/stderr to str)
        check=True,  # Optional: raises CalledProcessError if return code != 0
      )
    except:
      continue
    path = result.stdout.rstrip('\n').split(' ')[0] # remove ' (deleted)' from path

    # Skip OS processes
    exe = os.path.basename(path)
    if exe in ignoredPrograms:
      continue

    # Store information about an unknown process and then skip it
    jobid, nodeCount, account = joblist.getJobInfo(user)
    if not nodeCount:
      x = [hostname, user, pid, exe]
      if not x in unknown:
        unknown.append(x)
      continue

    # Skip job scheduler processes
    # if pcpu == "0.0":
    #   continue

    efficiency = float(pcpu)

    # Store the information in known
    if exe in known:
      known[exe][2] += efficiency
      known[exe][3] += 1
    else:
      known[exe] = [now, user, efficiency, 1, path, jobid, nodeCount, account]

  log = ""
  for exe in known:
    info = known[exe]

    # In the case where users use SMT and e.g. run with 32 processes on a node,
    # then one must divide by the number of cores per node: 16
    cores = info[3]
    if cores > coresPerNode: cores = coresPerNode 

    # Format: time, user, efficiency, path, jobid, coresPerNode, account
    log = log + "%s:%s:%s:%s:%s:%s:%s:%s\n" % (info[0], info[1], info[2]/cores, info[4], info[5], info[6], cores, info[7])

  errors = ""
  for host, user, pid, exe in unknown:
    if not user in allowedUsers:
      errors = errors + "%s: %s, %s, %s\n" % (host, pid, user, exe)

  return log, errors

# ******************************************************************************

# Store the latest information, while correcting previous errors
def writeLogData(log, errors, fileName):
  # Store all new entries in the log file
  with open(fileName, "a") as file:
    file.write(log)

  # Store information about unknown processes on this node 
  errorFileName = fileName+".err"

  if os.path.exists(errorFileName):
    os.remove(errorFileName)

  if len(errors) > 0:
    with open(errorFileName, "w") as file:
      file.write(errors)

# ******************************************************************************

# Main

# Read the config file
ok = init()

if ok:
  # Get information about the processes currently running on this compute node
  log, errors = getProcessInfo(hostName)

  # Store the process information in a file 
  writeLogData(log, errors, rootDir + "log/" + hostName)
